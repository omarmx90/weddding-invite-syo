# Copia a `.env.local`. Nunca commits valores reales.

# memory | supabase | auto
# Production (Vercel): RSVP_STORE=supabase
# Preview (Vercel):    RSVP_STORE=memory
# Development:         RSVP_STORE=memory (o auto → memory)
RSVP_STORE=memory

# Solo servidor — NUNCA NEXT_PUBLIC_ ni service role en el browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth admin (magic link) — anon key sí puede ser pública
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Allowlist admin (coma-separada, minúsculas normalizadas en servidor)
ADMIN_EMAILS=

# AES-256-GCM para invitation_secrets (32 bytes hex de 64 chars o base64)
# openssl rand -hex 32
INVITE_TOKEN_ENCRYPTION_KEY=

# Base URL al generar ligas privadas
# INVITE_SITE_URL=https://silvia-y-omar.com

# Solo testing local / Playwright — NUNCA en Production
# ADMIN_AUTH_MODE=test
# ADMIN_E2E_SECRET=
# RSVP_DEADLINE_ISO_OVERRIDE=
