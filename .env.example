# Copia a `.env.local`. Nunca commits valores reales.

# memory | supabase | auto
# Production (Vercel): RSVP_STORE=supabase
# Preview (Vercel):    RSVP_STORE=memory
# Development:         RSVP_STORE=memory (o auto → memory)
RSVP_STORE=memory

# Solo servidor — NUNCA NEXT_PUBLIC_ ni service role en el browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

